branch=$(git symbolic-ref --short HEAD)

# ── Bloquear commits diretos em branches protegidas ──────────────────────────
if [ "$branch" = "main" ] || [ "$branch" = "development" ]; then
  echo ""
  echo "❌  Commits diretos em '$branch' são proibidos."
  echo "    Crie uma branch: node scripts/new-feature.js <nome>"
  echo ""
  exit 1
fi

# -- Enforcer de issue -- obrigatorio em feature branches --------------------
# O contrato de inicio e uma issue `ready-for-agent`, nao um arquivo (ADR-0013).
# Convencao de branch: feature/<numero-da-issue>-<slug>.
if echo "$branch" | grep -q "^feature/"; then
  # `|| true`: o husky roda este arquivo com `sh -e`, e o grep sai 1 quando a
  # branch nao tem numero. Sem isso o hook morre aqui, mudo, antes de checar nada.
  issue=$(echo "${branch#feature/}" | grep -o "^[0-9]\+" || true)

  if [ -z "$issue" ]; then
    echo ""
    echo "!!  Branch sem numero de issue: $branch"
    echo "    A convencao e feature/<numero>-<slug> -- ver ADR-0013."
    echo "    Branch anterior a mudanca: seguindo, mas renomeie quando puder."
    echo ""
  elif ! command -v gh >/dev/null 2>&1; then
    echo "!!  gh nao encontrado -- checagem da issue #$issue pulada."
  else
    estado=$(gh issue view "$issue" --json state,labels 2>/dev/null || true)

    if [ -z "$estado" ]; then
      echo ""
      echo "XX  Issue #$issue nao encontrada."
      echo "    Branch : $branch"
      echo "    Toda feature comeca por uma issue -- ver ADR-0013."
      echo "    Crie com: node scripts/new-feature.js <numero-da-issue>"
      echo ""
      exit 1
    fi

    if ! echo "$estado" | grep -q "ready-for-agent"; then
      echo ""
      echo "XX  Issue #$issue nao esta ready-for-agent."
      echo "    Passe /triage nela ou aplique o label antes de commitar."
      echo "    gh issue edit $issue --add-label ready-for-agent"
      echo ""
      exit 1
    fi
  fi
fi

