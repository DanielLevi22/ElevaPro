# Lido pelo `supabase start` local via env() em config.toml — nunca vai para
# o app (Vercel/EAS). Copie para supabase/.env e preencha com valores reais.

# Resend — https://resend.com/api-keys (issue #332, SMTP do convite do aluno)
RESEND_API_KEY=re_your_resend_api_key

# Sem domínio verificado no Resend, use o endereço de teste deles
# (onboarding@resend.dev) — só entrega para o e-mail da sua própria conta
# Resend. Com domínio verificado, troque para algo como
# convites@seu-dominio-verificado.com
RESEND_SENDER_EMAIL=onboarding@resend.dev
