{
  "compilerOptions": {
    // Sem `baseUrl`: depreciado no TypeScript 6 e removido no 7. Os `paths`
    // abaixo já são relativos a este arquivo, que é como o tsconfig do app
    // (também em TS 6) sempre funcionou.
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/modules/*": ["./src/modules/*"],
      "@/shared/*": ["./src/shared/*"],
      "@/shared": ["./src/shared"],
      "@/auth": ["./src/modules/auth"],
      "@/admin": ["./src/modules/admin"],
      "@/dashboard": ["./src/modules/dashboard"],
      "@/nutrition": ["./src/modules/nutrition"],
      "@/workout": ["./src/modules/workouts"],
      "@/workouts": ["./src/modules/workouts"],
      "@/training-plans": ["./src/modules/training-plans"],
      "@elevapro/supabase": ["./src/packages/supabase"],
      "@elevapro/shared": ["../shared/src"],
      "@casl/ability": ["./node_modules/@casl/ability"],
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"],
      "zustand": ["./node_modules/zustand"],
      "zustand/*": ["./node_modules/zustand/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
