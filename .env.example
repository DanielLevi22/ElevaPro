# ─────────────────────────────────────────────────────────
# MeuPersonal — Variáveis de ambiente centralizadas
# Copie para .env.development e preencha com valores reais.
# Execute `npm run env:sync` para gerar os arquivos de cada projeto.
# ─────────────────────────────────────────────────────────

# Supabase — https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL direto — apenas para migrations Drizzle (nunca exposto no cliente)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# Anthropic — server-side apenas. Usada por todas as rotas /api/ai/* do web.
# Como o mobile chama a IA via BFF, sem esta chave as features de IA do app
# também param. https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Base do BFF (web) que o mobile consome — sem trailing slash.
# Emulador Android: http://10.0.2.2:3000 | Simulador iOS: http://localhost:3000
# Device físico: IP da máquina na LAN | Produção: https://elevapro.vercel.app
API_URL=http://10.0.2.2:3000
