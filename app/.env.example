# ============================================================
# Eleva Pro — Mobile (Expo)
#
# QUAL ARQUIVO O EXPO LÊ: ele escolhe pelo NODE_ENV, não pelo nome do perfil.
#   app/.env.development → `npm run android` / `expo start`   (NODE_ENV=development)
#   app/.env.production  → `npm run build:android:release`    (NODE_ENV=production)
#
# Um APK de release NÃO enxerga o .env.development. Sem .env.production as
# variáveis chegam vazias, o client do Supabase lança no import e o app fecha
# logo depois da splash — sem log e sem tela de erro.
#
# Build no EAS não usa nenhum dos dois: lê as variáveis do environment
# declarado no perfil de `eas.json` (`eas env:create --environment preview ...`).
# ============================================================

# ------ LOCAL (Supabase CLI via Docker — supabase start) ------
# Portas definidas em supabase/config.toml (47321/47322), não as default 543xx.
# Host: 10.0.2.2 no emulador Android · 127.0.0.1 no simulador iOS.
# Confirme as chaves com `supabase status -o env` — elas dependem do jwt_secret local.
# EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:47321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# EXPO_PUBLIC_APP_ENV=local

# ------ DEV / PROD (Supabase cloud) ------
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

EXPO_PUBLIC_APP_ENV=development

# URL base da web (BFF) — sem trailing slash
# Dev local: http://10.0.2.2:3000 (emulador Android) | http://localhost:3000 (iOS sim)
# Produção: https://elevapro.vercel.app
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Protection Bypass for Automation da Vercel — só no environment `preview`.
#
# O Deployment Protection fica na frente do deployment inteiro, rotas de API
# incluídas, e o app não tem sessão da Vercel. Sem esta variável toda chamada de
# IA recebe 302 para o SSO e o erro na tela nomeia a variável que falta.
#
# Não é segredo de verdade aqui: EXPO_PUBLIC_* é inlinada no bundle e sai do APK
# com um unzip — mesma razão pela qual a ANTHROPIC_API_KEY nunca vem para o
# mobile (ADR-004). Quem protege o dado é o api-auth do BFF, não este valor.
#
# Mudar o segredo exige BUILD NOVO: o valor já inlinado não se atualiza.
# Vazia em local e em produção.
# EXPO_PUBLIC_VERCEL_BYPASS=
