{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/modules/*": ["./src/modules/*"],
      "@/shared/*": ["./src/shared/*"],
      "@/nutrition": ["./src/modules/nutrition"],
      "@/workout": ["./src/modules/workout"],
      "@/students": ["./src/modules/students"],
      "@/auth": ["./src/modules/auth"],
      "@/technique": ["./src/modules/technique"],
      "@/assessment": ["./src/modules/assessment"],
      "@elevapro/core": ["./src/packages/core"],
      "@elevapro/supabase": ["./src/packages/supabase"],
      "@elevapro/shared": ["../shared/src"],
      "@elevapro/shared/*": ["../shared/src/*"],
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"],
      // O CASL 7 publica os tipos só pelo `exports`, que um `paths` para a pasta
      // ignora: aponta para o arquivo de tipos dele.
      "@casl/ability": ["./node_modules/@casl/ability/dist/types/index.d.ts"],
      "zustand": ["./node_modules/zustand"],
      "zustand/*": ["./node_modules/zustand/*"]
    },
    "jsx": "react-jsx",
    "types": ["jest", "node"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"]
}
